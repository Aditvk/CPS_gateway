# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Keys & Secrets (CRITICAL: Never commit private keys)
*.pem
*private.pem
!*public.pem
keys/*_private.pem

# Virtual Environments
env/
venv/
.venv/
ENV/

# Datasets and large weights
dataset/data/
*.pth
*.pt
*.bin
*.tar.gz
*.zip
*.pgm
*.npy

# Temporary artifacts & Demo outputs
demo_workspace/
temp/
logs/
*.log

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# LaTeX build artifacts
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.bbl
paper/*.blg
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk
